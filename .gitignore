# ---- Secrets / local config ----
.env
.env.*
!.env.example

# ---- Python bytecode / build artifacts ----
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# ---- Virtualenvs (uv keeps its env here) ----
.venv/
venv/
env/

# ---- Tool caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- ML models / weights (ultralytics re-downloads these) ----
models/
weights/
*.pt
*.onnx
*.engine
*.torchscript
*.tflite

# ---- Ultralytics run output (detections, labels, metrics) ----
runs/
*.avi

# ---- Generated output (tracked inputs in data/ are kept) ----
out/
/*_preview.webm
/speed_*.mp4
/outspeed_*.mp4
/detected*.mp4

# Notebook-generated videos (2_heart_rate_estimation.ipynb) and its inputs.
data/output/
data/input/

# ---- Video intermediates ----
# *_finalize() encodes to <name>.raw.mp4 first, then re-encodes to H.264.
*.raw.mp4

# ---- Preview clips (built by nbutils.video_utils.preview) ----
data/*_preview.webm

# ---- Editors / misc ----
.vs/
*.log
*.tmp
.cache/

# ---- IDE ----
.idea/
.vscode/

# ---- OS ----
.DS_Store
Thumbs.db
